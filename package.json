{
  "name": "gto-poker-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn GTO poker: equity solver, preflop charts, and bots with personalities to grind against.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "arena:run": "node --env-file=.env.arena.local --import tsx scripts/arena-run.ts",
    "arena:test": "vitest run src/arena",
    "arena:check": "tsc --noEmit -p tsconfig.arena.json",
    "arena:conformance": "tsx scripts/arena-conformance.ts",
    "arena:benchmark": "tsx scripts/arena-benchmark.ts",
    "arena:train-preflop": "tsx scripts/arena-train-preflop.ts",
    "arena:train-equity": "tsx scripts/arena-train-equity.ts",
    "arena:validate-preflop": "tsx scripts/arena-validate-preflop.ts",
    "arena:compare": "tsx scripts/arena-compare.ts",
    "arena:elimination": "tsx scripts/arena-elimination.ts"
  },
  "dependencies": {
    "@chipzen-ai/bot": "file:vendor/chipzen-ai-bot-0.3.1.tgz",
    "@supabase/supabase-js": "^2.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
}
